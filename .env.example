# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to just this server (shows up instantly) instead of everywhere
DISCORD_DEV_GUILD_ID=

# From "yarn workspace server run keys create ... --permissions lookup,link --webhook http://127.0.0.1:8090/link-events"
STRAFES_API_KEY=
STRAFES_WEBHOOK_SECRET=
# Defaults to https://strafes.fiveman1.net/public-api/v1
STRAFES_API_URL=

# Where the site sends link events. Only listens on this machine unless WEBHOOK_HOST says otherwise.
WEBHOOK_PORT=8090
WEBHOOK_HOST=127.0.0.1

# Optional: a role to give people once they're linked. Unlinking doesn't take it away.
VERIFIED_ROLE_ID=
# Optional: "true" to set people's nicknames to their Roblox username where they get the verified role (needs Manage
# Nicknames). Unlinking clears it, unless they've changed it since.
SET_NICKNAMES=
# Optional: where to welcome people when they get the verified role (so it needs VERIFIED_ROLE_ID)
WELCOME_CHANNEL_ID=
# Optional: where to log verifications
LOG_CHANNEL_ID=
